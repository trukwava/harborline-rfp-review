# Harborline runs as a loopback-only synthetic demo by default.
AUTH_MODE=demo
DEMO_MODE=true
PORT=4173
# To enable distinct password-authenticated local accounts (still loopback only),
# provision users first with `npm run provision:local`, and then set:
# AUTH_MODE=local
# DEMO_MODE=false
# DATA_DIR=./data  # optional provisioning database location
# Provisioning values are read from environment, not the repository:
# HARBOR_USER_EMAIL=...
# HARBOR_USER_PASSWORD=...  # 12+ characters; do not commit credentials
# HARBOR_ORGANIZATION=harbor-local
# HARBOR_USER_ROLE=director
